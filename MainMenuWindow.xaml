<Window x:Class="Game_Battleship.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship - Main Menu"
        Width="500"
        Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#16243C">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <TextBlock Text="BATTLESHIP"
                   FontSize="38"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,35"/>

        <Button x:Name="MenuStartButton"
                Content="Start Game"
                Width="200"
                Height="45"
                Margin="0,0,0,12"
                Click="MenuStartButton_Click"/>

        <Button x:Name="MenuAboutButton"
                Content="About"
                Width="200"
                Height="45"
                Margin="0,0,0,12"
                Click="MenuAboutButton_Click"/>

        <Button x:Name="MenuQuitButton"
                Content="Quit"
                Width="200"
                Height="45"
                Click="MenuQuitButton_Click"/>

    </StackPanel>
</Window>
