<Window x:Class="Game_Battleship.PlayerSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Battleship"
        mc:Ignorable="d"
        Title="Battleship - Player Setup"
        Height="350"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#16243C">

    <StackPanel Margin="30"
                VerticalAlignment="Center">

        <!-- Window title -->
        <TextBlock Text="PLAYER SETUP"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <!-- Player 1 -->
        <TextBlock Text="Player 1 Name"
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="Player1NameTextBox"
                 Height="35"
                 FontSize="16"
                 MaxLength="20"
                 Margin="0,0,0,15"/>

        <!-- Player 2 -->
        <TextBlock Text="Player 2 Name"
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="Player2NameTextBox"
                 Height="35"
                 FontSize="16"
                 MaxLength="20"
                 Margin="0,0,0,20"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button x:Name="BackButton"
                    Content="Back"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="BackButton_Click"/>

            <Button x:Name="ContinueButton"
                    Content="Continue"
                    Width="120"
                    Height="40"
                    Click="ContinueButton_Click"/>

        </StackPanel>
    </StackPanel>
</Window>
