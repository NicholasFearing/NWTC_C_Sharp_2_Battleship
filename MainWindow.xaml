<Window x:Class="Game_Battleship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship"
        Width="650"
        MinWidth="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <DockPanel x:Name="MainPanel" Margin="15">

        <!-- Main menu options -->
        <Menu DockPanel.Dock="Top"
              Margin="0,0,0,10">

            <MenuItem Header="Game">
                <MenuItem Header="Restart / Main Menu"
                          Click="ReturnToMenu_Click"/>
                <Separator/>
                <MenuItem Header="Quit"
                          Click="QuitGame_Click"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About"
                          Click="AboutGame_Click"/>
            </MenuItem>

        </Menu>

        <!-- Game controls -->
        <StackPanel x:Name="TopControls"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,10">

            <!-- Ship Selection -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="Select Ship:"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="ShipSelector"
                          Width="150"
                          Margin="10,0"
                          SelectedIndex="0">

                    <ComboBoxItem Content="Carrier" Tag="5"/>
                    <ComboBoxItem Content="Battleshipo" Tag="4"/>
                    <ComboBoxItem Content="D3estroyer" Tag="3"/>
                    <ComboBoxItem Content="Submarine" Tag="3"/>
                    <ComboBoxItem Content="Patrol Boat" Tag="2"/>

                </ComboBox>

                <RadioButton x:Name="HorizontalOption"
                             Content="Horizontal"
                             GroupName="Orientation"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Margin="10,0"/>

                <RadioButton x:Name="VerticalOption"
                             Content="Vertical"
                             GroupName="Orientation"
                             VerticalAlignment="Center"
                             Margin="10,0"/>

            </StackPanel>

            <!-- Shot controls -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="Shot Tool:"
                           VerticalAlignment="Center"/>

                <RadioButton x:Name="HitOption"
                             Content="Hit"
                             GroupName="ShotTools"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Margin="10,0"/>

                <RadioButton x:Name="MissOption"
                             Content="Miss"
                             GroupName="ShotTools"
                             VerticalAlignment="Center"
                             Margin="10,0"/>

                <RadioButton x:Name="ResetOption"
                             Content="Back to Blue"
                             GroupName="ShotTools"
                             VerticalAlignment="Center"
                             Margin="10,0"/>

                <Button x:Name="StartButton"
                        Content="Start Game"
                        Width="120"
                        Height="30"
                        Margin="25,0,0,0"
                        Click="StartButton_Click"/>

            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Text="Player 1 - Place your ships."
                       FontSize="14"
                       Margin="5,5,0,0"/>

        </StackPanel>

        <!-- Main Game Area -->
        <Grid x:Name="GameArea"
              VerticalAlignment="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Both players board containers -->
            <Grid x:Name="BoardsContainer"
                  Grid.Row="0">

                <!-- ================================= -->
                <!-- PLAYER 1 BOARDS                   -->
                <!-- ================================= -->

                <StackPanel x:Name="Player1BoardsPanel"
                            HorizontalAlignment="Center"
                            Visibility="Visible">

                    <!-- Player 1 Top -->
                    <StackPanel Margin="5,5,5,10">

                        <TextBlock Text="Player 1 - Your Shots"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <Grid Width="250" Height="250">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid x:Name="Player1TopColumnLabels"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Rows="1"
                                         Columns="10"/>

                            <UniformGrid x:Name="Player1TopRowLabels"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Rows="10"
                                         Columns="1"/>

                            <UniformGrid x:Name="Player1TopGrid"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Rows="10"
                                         Columns="10"/>

                        </Grid>
                    </StackPanel>

                    <!-- Player 1 Bottom -->
                    <StackPanel Margin="5,5,5,10">

                        <TextBlock Text="Player 1 - Your Ships"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <Grid Width="250" Height="250">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid x:Name="Player1BottomColumnLabels"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Rows="1"
                                         Columns="10"/>

                            <UniformGrid x:Name="Player1BottomRowLabels"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Rows="10"
                                         Columns="1"/>

                            <UniformGrid x:Name="Player1BottomGrid"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Rows="10"
                                         Columns="10"/>

                        </Grid>
                    </StackPanel>

                </StackPanel>

                <!-- ================================= -->
                <!-- PLAYER 2 BOARDS                   -->
                <!-- ================================= -->

                <StackPanel x:Name="Player2BoardsPanel"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">

                    <!-- Player 2 Top -->
                    <StackPanel Margin="5,5,5,10">

                        <TextBlock Text="Player 2 - Your Shots"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <Grid Width="250" Height="250">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid x:Name="Player2TopColumnLabels"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Rows="1"
                                         Columns="10"/>

                            <UniformGrid x:Name="Player2TopRowLabels"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Rows="10"
                                         Columns="1"/>

                            <UniformGrid x:Name="Player2TopGrid"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Rows="10"
                                         Columns="10"/>

                        </Grid>
                    </StackPanel>

                    <!-- Player 2 Bottom -->
                    <StackPanel Margin="5,5,5,10">

                        <TextBlock Text="Player 2 - Your Ships"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <Grid Width="250" Height="250">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid x:Name="Player2BottomColumnLabels"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Rows="1"
                                         Columns="10"/>

                            <UniformGrid x:Name="Player2BottomRowLabels"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Rows="10"
                                         Columns="1"/>

                            <UniformGrid x:Name="Player2BottomGrid"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Rows="10"
                                         Columns="10"/>

                        </Grid>
                    </StackPanel>

                </StackPanel>

            </Grid>

            <!-- End Turn -->
            <Button x:Name="EndTurnButton"
                    Grid.Row="1"
                    Content="End Turn"
                    Width="150"
                    Height="40"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,10"
                    Click="EndTurnButton_Click"/>

            <!-- Screen between turns -->
            <Grid x:Name="TurnOverlay"
                  Grid.RowSpan="2"
                  Background="#FF172334"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="TurnMessage"
                               Text="Pass to Player 2"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Both boards are hidden."
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <Button x:Name="ReadyButton"
                            Content="I'm Ready"
                            Width="160"
                            Height="45"
                            HorizontalAlignment="Center"
                            Click="ReadyButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </DockPanel>
</Window>
